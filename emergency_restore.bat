@echo off
:: Anti-Block Toolkit - Standalone Emergency Restore
title Anti-Block Toolkit - Emergency Restore
echo ====================================================
echo   Anti-Block Toolkit - Intelligent System Restore
echo ====================================================
echo Checking Administrator privileges...
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo [ERROR] Administrator rights required.
    echo Please right-click this file and select 'Run as administrator'.
    pause
    exit /b 1
)

echo [1/3] Restoring DNS configuration from backup (strictly validated)...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$bPath = Join-Path $PSScriptRoot 'config\backup.json'; if (-not (Test-Path $bPath)) { $bPath = Join-Path $env:APPDATA 'AntiBlockToolkit\config\backup.json' }; if (Test-Path $bPath) {     try {         $bData = Get-Content $bPath -Raw | ConvertFrom-Json;         if ($bData.timestamp -and $bData.adapters -and ($bData.adapters.PSObject.Properties.Count -gt 0)) {             Write-Host 'Found valid backup.json - restoring exact original settings...';             foreach ($prop in $bData.adapters.PSObject.Properties) {                 $name = $prop.Name; $ad = $prop.Value;                 if ($ad.is_dhcp -or -not $ad.servers) {                     Write-Host ('Resetting ' + $name + ' to DHCP');                     Set-DnsClientServerAddress -InterfaceAlias $name -ResetServerAddresses -ErrorAction SilentlyContinue;                 } else {                     Write-Host ('Restoring ' + $name + ' to static: ' + ($ad.servers -join ', '));                     Set-DnsClientServerAddress -InterfaceAlias $name -ServerAddresses $ad.servers -ErrorAction SilentlyContinue;                 }             }         } else {             Write-Host '[PROTECTED] backup.json failed schema validation. Leaving adapter DNS unmodified.';         }     } catch {         Write-Host '[PROTECTED] Failed to parse backup.json. Leaving adapter DNS unmodified.';     } } else {     Write-Host '[PROTECTED] No backup.json found. Leaving adapter DNS unmodified to avoid clobbering.'; }"

echo [2/3] Checking WinINET Proxy backup snapshot (strictly validated)...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$pPath = Join-Path $PSScriptRoot 'config\proxy_backup.json'; if (-not (Test-Path $pPath)) { $pPath = Join-Path $env:APPDATA 'AntiBlockToolkit\config\proxy_backup.json' }; if (Test-Path $pPath) {     try {         $pData = Get-Content $pPath -Raw | ConvertFrom-Json;         $dt = [DateTime]::MinValue;         $hasValidTs = ($pData.timestamp -and ($pData.timestamp -is [string]) -and [DateTime]::TryParse($pData.timestamp, [ref]$dt));         $hasValidSettings = ($pData.settings -and ($pData.settings -is [System.Management.Automation.PSCustomObject]));         $hasValidProxyEnable = $true;         if ($hasValidSettings -and ($null -ne $pData.settings.ProxyEnable)) {             $pe = $pData.settings.ProxyEnable;             if ($pe -notin 0, 1, '0', '1') { $hasValidProxyEnable = $false };         };         if ($hasValidTs -and $hasValidSettings -and $hasValidProxyEnable) {             Write-Host 'Found valid proxy_backup.json - restoring original user configuration...';             $regKey = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings';             if ($null -ne $pData.settings.ProxyEnable) {                 Set-ItemProperty -Path $regKey -Name ProxyEnable -Value ([int]$pData.settings.ProxyEnable) -Type DWord -ErrorAction SilentlyContinue;                 Write-Host ('Restored ProxyEnable -> ' + [string]$pData.settings.ProxyEnable);             } else {                 Remove-ItemProperty -Path $regKey -Name ProxyEnable -ErrorAction SilentlyContinue;                 Write-Host 'Removed ProxyEnable key (was originally absent).';             };             if ($null -ne $pData.settings.ProxyServer) {                 Set-ItemProperty -Path $regKey -Name ProxyServer -Value ([string]$pData.settings.ProxyServer) -Type String -ErrorAction SilentlyContinue;             } else {                 Remove-ItemProperty -Path $regKey -Name ProxyServer -ErrorAction SilentlyContinue;             };             if ($null -ne $pData.settings.ProxyOverride) {                 Set-ItemProperty -Path $regKey -Name ProxyOverride -Value ([string]$pData.settings.ProxyOverride) -Type String -ErrorAction SilentlyContinue;             } else {                 Remove-ItemProperty -Path $regKey -Name ProxyOverride -ErrorAction SilentlyContinue;             };             if ($null -ne $pData.settings.AutoDetect) {                 Set-ItemProperty -Path $regKey -Name AutoDetect -Value ([int]$pData.settings.AutoDetect) -Type DWord -ErrorAction SilentlyContinue;             } else {                 Remove-ItemProperty -Path $regKey -Name AutoDetect -ErrorAction SilentlyContinue;             };             if ($null -ne $pData.settings.AutoConfigURL) {                 Set-ItemProperty -Path $regKey -Name AutoConfigURL -Value ([string]$pData.settings.AutoConfigURL) -Type String -ErrorAction SilentlyContinue;             } else {                 Remove-ItemProperty -Path $regKey -Name AutoConfigURL -ErrorAction SilentlyContinue;             };             Write-Host '[SUCCESS] Original WinINET Proxy settings restored.';         } else {             Write-Host '[PROTECTED] proxy_backup.json failed schema validation. Leaving proxy unmodified.';         }     } catch {         Write-Host '[PROTECTED] Failed to parse proxy_backup.json. Leaving proxy settings intact to avoid clobbering.';     } } else {     Write-Host '[PROTECTED] No proxy_backup.json found. Leaving user proxy settings unmodified.'; }"

echo [3/3] Flushing DNS resolver cache...
ipconfig /flushdns >nul

echo ====================================================
echo [SUCCESS] Network settings have been safely restored!
echo ====================================================
pause
